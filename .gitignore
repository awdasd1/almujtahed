# ==============================================================================
# منظومة المجتهد - استثناء الملفات الضخمة والبيئة من GitHub (.gitignore)
# للمحافظة على نسخة برمجية فائقة الخفة (~15-20 MB) تُرفع فورياً
# ==============================================================================

# بيئة بايثون والملفات المؤقتة
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/
*.egg-info/
dist/
build/

# ملفات الأسرار والبيئة المحلية (لا تُرفع لمنع تسريب المفاتيح)
.env
.env.local
*.log
web_ui/members.json
web_ui/notices.json

# الملفات وقواعد البيانات الضخمة (تُسحب آلياً عبر Coolify عند التنصيب)
qdrant_service/storage/
qdrant_service/snapshots/
qdrant_service/qdrant
qdrant_service/*.log
qdrant_store/
*.snapshot
shamela4_data/
models/
inference_models/
# النماذج المحلية التي تُسحب داخل التطبيق تبقى على الخادم ولا تُرفع للمستودع
models/local/
*.gguf
*.partial
*.bin
*.safetensors
*.tar.gz
*.zip

# ملفات النظام والمجلدات المؤقتة
.DS_Store
Thumbs.db
tmp/
.tempmediaStorage/

# ملفات النسخ الاحتياطي ومرفوعات المستخدم والبيانات المؤقتة
web_ui/backups/
web_ui/model_about_ar_cache.json
web_ui/app_memory.db
web_ui/app_memory.db-wal
web_ui/app_memory.db-shm
web_ui/gpu_mode.json
web_ui/almojtahed.db
web_ui/uploads/*
!web_ui/uploads/.gitkeep
web_ui/fonts/*
!web_ui/fonts/.gitkeep
web_app/user_assistants.json
