<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AlMujtahedSetup</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace>AlMujtahed.Setup</RootNamespace>
    <Version>1.10.536</Version>
    <InformationalVersion>1.10.536</InformationalVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="AlMujtahedApp.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadZip)" Condition="'$(PayloadZip)' != ''">
      <LogicalName>payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
